NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/environmental_hackathon
CLIENT_ORIGIN=http://localhost:5173

# Xweather forecasts, maritime and gated lightning, sharing an allowance with the summary campaign. Server-side only.
XWEATHER_CLIENT_ID=your_client_id
XWEATHER_CLIENT_SECRET=your_client_secret
XWEATHER_BASE_URL=https://data.api.xweather.com
# Last known free allowance; the app updates the real value from API response headers.
XWEATHER_BUDGET_REMAINING=14817
XWEATHER_BUDGET_RESERVE=100
XWEATHER_REQUESTS_PER_MINUTE=60
# Cost per request assumed until a response reports its real X-Cost-Tokens.
XWEATHER_ASSUMED_COST=1

# Lightning campaign (times are Asia/Dhaka). Leave the start empty to begin on the first run with credentials.
LIGHTNING_ENABLED=on
LIGHTNING_CAMPAIGN_START=
LIGHTNING_CAMPAIGN_DAYS=10
LIGHTNING_MAX_SLOTS=30

# Weather collection. Set WEATHER_JOBS=off to run the API without background jobs.
WEATHER_JOBS=on

# Alert engine. ALERT_ENGINE=off disables detection and automatic sending. ALERT_XWEATHER=off keeps it off the Xweather allowance.
ALERT_ENGINE=on
ALERT_XWEATHER=on
ALERT_BULLETINS=on
ALERT_TICK_MINUTES=2
ALERT_MAX_SUBSCRIBERS=5000
ALERT_MAX_FORECAST_AREAS=10
ALERT_MAX_MARINE_POINTS=4
ALERT_LIGHTNING_BASELINE=on
ALERT_ACTIVITY_TTL_HOURS=12
ALERT_DAILY_ADVISORY_CAP=3
# Set to "on" only after BMD's rainfall unit per step has been confirmed (see ALERT_ENGINE_PLAN.md, spike S3).
ALERT_BMD_RAIN_VERIFIED=off
# Optional heavy-rain forecast confidence from ml-service/ (adds "Forecast confidence: High/Medium/Low" to Level 2+ rain alerts).
# Start it with: cd ml-service && .venv/Scripts/python -m uvicorn app:app --host 127.0.0.1 --port 8001
# Leave empty to turn it off; alerts are unchanged without it.
ML_SERVICE_URL=
ML_TIMEOUT_MS=3000

# Admin dashboard (/admin). One shared passcode (at least 8 characters). Leave the placeholder to keep /admin disabled.
ADMIN_PASSCODE=change_me_before_use
# Local demos only: skip the login. Ignored in production and for non-loopback requests.
ADMIN_AUTH=on
ADMIN_SESSION_HOURS=8

# Optional: set when mongodb+srv:// fails with "querySrv ECONNREFUSED" because Node cannot reach a DNS server.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------------------------------------------------------------------------
# History of forecast runs kept in MongoDB for trends and back-testing (per-district summaries, about 20 KB per run). 0 = off.
WEATHER_HISTORY_DAYS=60

# Number of reverse proxies in front of the API (1 on most hosts). Leave 0 when the API is reached directly; behind a proxy it keeps
# the per-address rate limits from counting everyone as one visitor.
TRUST_PROXY=0

# ---------------------------------------------------------------------------------------------------------------------------------
# External delivery: Telegram, WhatsApp and SMS. Everything below is optional; each channel stays off until it is configured, and alerts
# always reach the in-app inbox. DELIVERY=off turns the whole delivery layer off.
DELIVERY=on
# The public address of the site, used for the "Details" link inside messages.
PUBLIC_URL=http://localhost:5173
# Required for WhatsApp and SMS: encrypts the phone numbers people verify (at least 16 characters, random). If it changes, stored
# numbers can no longer be read and those people must verify again.
CHANNEL_SECRET=change_me_to_a_long_random_value
# How often queued messages are sent, how often a failed send is tried, and how old an alert may be and still be sent to a channel.
DELIVERY_TICK_SECONDS=30
DELIVERY_MAX_ATTEMPTS=4
DELIVERY_MAX_AGE_MINUTES=180
# Messages per person per channel per Bangladesh day (CRITICAL alerts are never held back by this) and the lowest severity each channel
# carries (ADVISORY, WARNING or CRITICAL). SMS and WhatsApp can cost money per message, so they start at WARNING.
DELIVERY_DAILY_CAP_TELEGRAM=20
DELIVERY_DAILY_CAP_WHATSAPP=6
DELIVERY_DAILY_CAP_SMS=6
DELIVERY_MIN_SEVERITY_TELEGRAM=ADVISORY
DELIVERY_MIN_SEVERITY_WHATSAPP=WARNING
DELIVERY_MIN_SEVERITY_SMS=WARNING

# Telegram: create a bot with @BotFather and paste its token. Without a webhook URL the server polls Telegram (fine for local use).
# For a webhook set TELEGRAM_WEBHOOK_URL to https://<your-domain>/api/channels/telegram/webhook and a secret of 16-256 characters
# (A-Z a-z 0-9 _ -).
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# The bot answers weather commands (/update, /heat, /rain ...) for anyone who messages it. One chat may send this many in ten minutes.
TELEGRAM_COMMAND_LIMIT=30
# The morning weather message: every day at MORNING_DIGEST_TIME (Bangladesh time) each Telegram chat connected to a profile with a saved
# area is sent today's weather for that area. A server that was down at that time still sends it for MORNING_DIGEST_GRACE_HOURS afterwards
# (the window is never shorter than ten minutes and never runs past midnight); later than that the day is skipped. MORNING_DIGEST=off
# turns it off.
MORNING_DIGEST=on
MORNING_DIGEST_TIME=06:00
MORNING_DIGEST_GRACE_HOURS=4

# WhatsApp Business Cloud API (Meta). Needs two approved message templates: see README, "WhatsApp templates".
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ALERT_TEMPLATE=akashsathi_alert
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG_EN=en
WHATSAPP_TEMPLATE_LANG_BN=bn

# SMS: SMS_PROVIDER=twilio or http. Twilio needs the account SID, auth token and either a From number or a messaging service SID.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# A generic HTTP gateway (most Bangladeshi bulk-SMS providers). Placeholders: {to} +8801712345678, {to_digits} 8801712345678,
# {to_local} 01712345678, {text}. GET example:
#   SMS_HTTP_URL=https://gateway.example/api/send?api_key=KEY&sender=AkashSathi&to={to_digits}&message={text}
#   SMS_HTTP_METHOD=GET
# POST example (JSON body; the text can contain quotes and line breaks safely):
#   SMS_HTTP_URL=https://gateway.example/api/send
#   SMS_HTTP_METHOD=POST
#   SMS_HTTP_CONTENT_TYPE=application/json
#   SMS_HTTP_BODY={"sender":"AkashSathi","to":"{to_digits}","text":"{text}"}
#   SMS_HTTP_HEADERS={"Authorization":"Bearer KEY"}
# Many gateways answer HTTP 200 even for a refused message: set a pattern the success reply must match, for example "success".
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_CONTENT_TYPE=application/json
SMS_HTTP_BODY=
SMS_HTTP_HEADERS=
SMS_HTTP_SUCCESS_MATCH=
